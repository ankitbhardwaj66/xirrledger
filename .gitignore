# Virtual environment
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# un-ignore Next.js lib source — root lib/ pattern above would otherwise exclude it
!website/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Sensitive data - CSV files
*.csv
*.xlsx
!example*.csv

# Ledger folder - keep structure but ignore CSV files
ledger/*.csv
ledger/*.xlsx

# Reports folder - keep structure but ignore PDF reports (except sample)
reports/*.pdf
!reports/sample_report.pdf

# Logs
*.log

# Streamlit
.streamlit/secrets.toml
temp_*.csv
temp_*.pdf

# PyInstaller build artifacts
build/
dist/
*.spec

# X.com commenter — state files
marketing/x/.x_session/
marketing/x/.seen_posts.json
marketing/x/.seen_authors.json
marketing/x/comments_log.jsonl
