Options -Indexes

# ─── URL canonicalisation (single RewriteEngine block — order matters) ───────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Strip /index.html — Next.js static export creates page/index.html which
    #    Apache serves at both /page/ and /page/index.html, causing duplicate pages.
    #    Redirect the index.html variant to the canonical trailing-slash URL.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(.*)index\.html[\s?]
    RewriteRule ^ /%1 [R=301,L]

    # 2. www + no trailing slash + not a file → non-www + trailing slash (1 hop)
    RewriteCond %{HTTP_HOST} ^www\.xirrledger\.com$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ https://xirrledger.com/$1/ [R=301,L]

    # 3. www + trailing slash (or a file) → non-www, same path (1 hop)
    RewriteCond %{HTTP_HOST} ^www\.xirrledger\.com$ [NC]
    RewriteRule ^(.*)$ https://xirrledger.com/$1 [R=301,L]

    # 4. Non-www, no trailing slash, not a file → add trailing slash
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ─── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ─── Cache: Next.js hashed static assets (1 year) ────────────────────────────
# _next/static/ filenames contain content hashes — safe to cache indefinitely
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/_next/static/
    RewriteRule ^ - [E=STATIC_ASSET:1]
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=STATIC_ASSET

    # HTML pages: short cache (10 min) so browsers reuse on revisit without hammering origin
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=600"
    </FilesMatch>

    # ─── Security headers ────────────────────────────────────────────────────
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
