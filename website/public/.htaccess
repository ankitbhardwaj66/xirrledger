Options -Indexes

# ─── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ─── Cache: Next.js hashed static assets (1 year) ────────────────────────────
# _next/static/ filenames contain content hashes — safe to cache indefinitely
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/_next/static/
    RewriteRule ^ - [E=STATIC_ASSET:1]
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=STATIC_ASSET

    # HTML pages must never be cached (content changes on each deploy)
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
