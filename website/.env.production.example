# Copy to .env.production on the server — never commit .env.production to git.
# Each server (prod / dev) has its own values.

# API Gateway URL for this environment
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com

# S3 jobs bucket base URL for this environment (for status polling)
NEXT_PUBLIC_JOBS_BASE_URL=https://xirrledger-jobs<-dev>.s3.ap-south-1.amazonaws.com

# Google Analytics measurement ID — omit entirely on dev to disable GA
# NEXT_PUBLIC_GA_ID=G-2YGVB963RE
