# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit secrets.

aws_region             = "ap-south-1"
environment            = "dev"
domain_name            = "xirrledger.com"
ses_from_email         = "reports@xirrledger.com"
hostinger_api_url      = "https://dev.xirrledger.com/api"
hostinger_api_secret_name = "xirrledger/prod/hostinger_api_secret"
lambda_memory_mb       = 512
lambda_timeout_seconds = 120
