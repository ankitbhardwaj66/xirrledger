hostinger_api_url      = "https://dev.xirrledger.com/api"
hostinger_api_secret   = "REPLACE_WITH_A_STRONG_RANDOM_SECRET"
test_emails            = "ankitbhardwaj244487@gmail.com"
lambda_memory_mb       = 512
lambda_timeout_seconds = 120
